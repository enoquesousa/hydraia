# HydraIA - Variáveis de Ambiente (TEMPLATE)
# Copie este arquivo para .env e preencha com suas chaves reais.
# IMPORTANTE: o arquivo .env nunca deve ser versionado (já consta no .gitignore).

# ─── Chaves de API obrigatórias ───────────────────────────────────────
# OpenWeather One Call 3.0 — https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_key_here

# Google Gemini — https://aistudio.google.com/app/apikey
GEMINI_ULTRA_API_KEY=your_gemini_key_here

# OpenAI GPT — https://platform.openai.com/api-keys
OPENAI_GPT5_API_KEY=your_openai_key_here

# ─── Configurações HTTP (opcionais) ───────────────────────────────────
HTTP_TIMEOUT=30
HTTP_RETRY_ATTEMPTS=3
LOG_LEVEL=INFO

# ─── Override de modelos (opcionais) ──────────────────────────────────
# Sobrescrevem os defaults definidos em config_apis.json.
# GPT_MODEL=gpt-4o
# GEMINI_MODEL=gemini-2.5-pro
